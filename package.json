{
  "name": "sammyify",
  "version": "1.0.0",
  "description": "Sammyify - personal music player",
  "main": "main.js",
  "author": "sammyRBLX",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.2.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.sammyify.app",
    "productName": "Sammyify",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "Sammyify.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sammyRBLX",
        "repo": "Sammyify",
        "releaseType": "release"
      }
    ]
  }
}